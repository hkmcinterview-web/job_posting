# ── 텔레그램 (필수) ──────────────────────────────────────
# @BotFather 에서 봇 생성 후 받은 토큰
TELEGRAM_BOT_TOKEN=
# 본인 계정의 chat_id (봇 실행 후 메시지를 보내면 로그에 출력됩니다. 콤마로 여러 개 가능)
TELEGRAM_ALLOWED_CHAT_IDS=

# ── 네이버 (카페 게시에 필수) ────────────────────────────
# developers.naver.com 애플리케이션의 Client ID / Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 애플리케이션에 등록한 Callback URL 과 동일하게
NAVER_REDIRECT_URI=https://localhost/callback
# 카페 숫자 ID / 게시판 숫자 ID (README 참고)
NAVER_CAFE_CLUB_ID=
NAVER_CAFE_MENU_ID=

# ── AI 요약 (선택 — 설정하면 위트있는 헤드라인으로 카드 품질이 좋아집니다) ──
# ① 구글 Gemini — 무료 등급 추천! https://aistudio.google.com/apikey 에서 발급
#    (구글 계정만 있으면 카드 없이 무료로 키 발급됨)
#    구글 계정을 여러 개 써서 키를 여러 개 만들었다면 콤마로 나열하세요 — 한 키가
#    할당량 초과(429)면 봇이 자동으로 다음 키로 넘어갑니다. 예: GEMINI_API_KEY=키1,키2,키3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# ② Claude — 유료 (Gemini 키가 있으면 Gemini 를 우선 사용)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── 게시글 꾸미기 (선택) ─────────────────────────────────
BRAND_NAME=공대생현직자 잡앤유
POST_HEADER=
POST_FOOTER=<p>본 게시글은 자동으로 작성되었습니다.</p>
# 메시지당 처리할 최대 링크 수 / 링크당 헤드라인 선택 후보 개수(2~3)
MAX_LINKS=5
MAX_CARDS_PER_LINK=3
# 생성된 카드를 텔레그램으로도 회신할지 (1=예, 0=아니오)
SEND_CARDS_TO_TELEGRAM=1
