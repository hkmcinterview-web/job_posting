# ── 텔레그램 (필수) ──────────────────────────────────────
# @BotFather 에서 봇 생성 후 받은 토큰
TELEGRAM_BOT_TOKEN=
# 본인 계정의 chat_id (봇 실행 후 메시지를 보내면 로그에 출력됩니다. 콤마로 여러 개 가능)
TELEGRAM_ALLOWED_CHAT_IDS=

# ── 네이버 (카페 게시에 필수) ────────────────────────────
# developers.naver.com 애플리케이션의 Client ID / Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 애플리케이션에 등록한 Callback URL 과 동일하게
NAVER_REDIRECT_URI=https://localhost/callback
# 카페 숫자 ID / 게시판 숫자 ID (README 참고)
NAVER_CAFE_CLUB_ID=
NAVER_CAFE_MENU_ID=

# '뉴스' 검색 명령용 — 네이버 '검색' API 는 앱에 '검색' 스코프가 있어야 합니다.
# 카페용 앱에 '검색'을 추가했다면 아래는 비워두세요(위 CLIENT_ID/SECRET 사용).
# 검색을 별도 앱으로 쓸 때만 채우세요.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ── NewsAPI.org (선택 — '헤드라인' 명령용) ─────────────────
# newsapi.org 에서 무료 키 발급. '헤드라인' 명령으로 국가/카테고리별 톱뉴스를 받습니다.
# 무료 등급은 하루 100회 + 기사 24시간 지연 제약이 있어, 최신 속보는 '해외이슈'
# (구글 뉴스 RSS, 키 불필요)를 쓰는 게 낫습니다. 둘은 독립적으로 동작합니다.
NEWSAPI_KEY=

# ── AI 요약 (선택 — 설정하면 위트있는 헤드라인으로 카드 품질이 좋아집니다) ──
# ① 구글 Gemini — 무료 등급 추천! https://aistudio.google.com/apikey 에서 발급
#    (구글 계정만 있으면 카드 없이 무료로 키 발급됨)
#    구글 계정을 여러 개 써서 키를 여러 개 만들었다면 콤마로 나열하세요 — 한 키가
#    할당량 초과(429)면 봇이 자동으로 다음 키로 넘어갑니다. 예: GEMINI_API_KEY=키1,키2,키3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# ② Claude — 유료 (Gemini 키가 있으면 Gemini 를 우선 사용)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ③ OpenRouter — '비교' 명령 전용 (무료 오픈모델 품질 비교). https://openrouter.ai 에서 무료 키 발급.
#    ⚠️ 계정에 결제수단/크레딧을 넣지 않으면 과금 위험 0 (무료 모델만 되고 유료 모델은 실패).
#    OPENROUTER_MODELS 를 비워두면 봇이 '지금 무료인 모델'을 자동으로 골라 비교합니다(권장).
#    특정 모델만 쓰고 싶을 때만 콤마로 나열하세요.
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=
# OPENROUTER_AUTO_COUNT=3

# ④ Groq — '비교'/'카드' 다중모델용 (무료 한도 넉넉·빠름·429 적음). https://console.groq.com 에서 무료 키 발급.
#    비교할 모델 ID 는 console.groq.com/docs/models 에서 확인 후 아래를 갱신하면 됩니다.
GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile,gemma2-9b-it

# ── 게시글 꾸미기 (선택) ─────────────────────────────────
BRAND_NAME=공대생현직자 잡앤유
POST_HEADER=
POST_FOOTER=<p>본 게시글은 자동으로 작성되었습니다.</p>
# 메시지당 처리할 최대 링크 수 / 링크당 헤드라인 선택 후보 개수(2~3)
MAX_LINKS=5
MAX_CARDS_PER_LINK=3
# 생성된 카드를 텔레그램으로도 회신할지 (1=예, 0=아니오)
SEND_CARDS_TO_TELEGRAM=1
